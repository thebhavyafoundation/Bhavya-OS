{
  "name": "@bhavya/database",
  "version": "0.1.0",
  "description": "Bhavya OS database — SQLite abstraction, migrations, repositories",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sqlite": "./src/sqlite.ts",
    "./migrate": "./src/migrate.ts",
    "./registry": "./src/registry.ts"
  },
  "scripts": {
    "test": "node --test src/__tests__/database.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/cli.ts",
    "db:migrate:status": "tsx src/cli.ts status"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.1"
  },
  "license": "MIT"
}
