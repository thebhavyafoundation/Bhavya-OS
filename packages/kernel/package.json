{
  "name": "@bhavya/kernel",
  "version": "3.1.0",
  "description": "Bhavya Kernel - The core runtime for Bhavya OS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@bhavya/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^3.2.1"
  }
}
