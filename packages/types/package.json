{
  "name": "@bhavya/types",
  "version": "0.1.0",
  "description": "Bhavya OS shared TypeScript types — canonical domain models for all packages",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./knowledge": "./src/knowledge.ts",
    "./user": "./src/user.ts",
    "./workflow": "./src/workflow.ts",
    "./events": "./src/events.ts",
    "./artifacts": "./src/artifacts.ts",
    "./pipeline": "./src/pipeline.ts",
    "./search": "./src/search.ts",
    "./notifications": "./src/notifications.ts",
    "./audit": "./src/audit.ts",
    "./providers": "./src/providers.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
