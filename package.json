{
  "name": "bhavya-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "validate": "pnpm --filter @bhavya/content-core validate",
    "scaffold": "pnpm --filter @bhavya/content-core scaffold",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css}\"",
    "clean": "turbo clean && git clean -xdf .turbo node_modules",
    "registry:generate": "node scripts/generate-registry.js",
    "file-map": "node scripts/generate-file-map.mjs",
    "file-map:check": "node scripts/generate-file-map.mjs && git diff --exit-code -- FILE-MAP.md",
    "runtime:compile": "node .ai/build/compile-runtime.mjs",
    "runtime:validate": "node .ai/build/validate-runtime.mjs",
    "runtime:daemon": "node packages/runtime/daemon/watch.mjs",
    "runtime:daemon:once": "node packages/runtime/daemon/watch.mjs --once",
    "bhavya": "node packages/runtime/cli/bhavya.mjs",
    "bhavya:status": "node packages/runtime/cli/bhavya.mjs runtime status",
    "bhavya:plan": "node packages/runtime/cli/bhavya.mjs planner build",
    "bhavya:task": "node packages/runtime/cli/bhavya.mjs task next",
    "bhavya:api": "node packages/runtime/cli/bhavya.mjs api start",
    "prepare": "husky",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "dev:admin": "turbo dev --filter=@bhavya/admin-app",
    "build:admin": "turbo build --filter=@bhavya/admin-app",
    "admin": "pnpm --filter @bhavya/admin-app dev",
    "vercel:build": "vercel build",
    "vercel:deploy": "vercel deploy --prebuilt",
    "vercel:deploy:app": "node scripts/vercel-build-app.mjs",
    "vercel:deploy:all": "bash scripts/deploy-all-vercel.sh",
    "dashboard": "pnpm --filter @bhavya/dashboard dev",
    "studio": "pnpm --filter @bhavya/lesson-studio dev",
    "studio:build": "pnpm --filter @bhavya/lesson-studio build",
    "studio:full": "start cmd /k \"pnpm run bhavya:api\" && pnpm run studio",
    "bhavya:api:verbose": "node packages/runtime/cli/api-standalone.mjs"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "next": "15.5.20",
    "prettier": "^3.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.1.13",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
