{
  "name": "bhavya-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css}\"",
    "clean": "turbo clean && git clean -xdf .turbo node_modules",
    "registry:generate": "node scripts/generate-registry.js",
    "runtime:compile": "node .ai/build/compile-runtime.mjs",
    "runtime:validate": "node .ai/build/validate-runtime.mjs",
    "runtime:daemon": "node packages/runtime/daemon/watch.mjs",
    "runtime:daemon:once": "node packages/runtime/daemon/watch.mjs --once",
    "bhavya": "node packages/runtime/cli/bhavya.mjs",
    "bhavya:status": "node packages/runtime/cli/bhavya.mjs runtime status",
    "bhavya:plan": "node packages/runtime/cli/bhavya.mjs planner build",
    "bhavya:task": "node packages/runtime/cli/bhavya.mjs task next",
    "bhavya:api": "node packages/runtime/cli/bhavya.mjs api start",
    "prepare": "husky",
    "deploy": "node scripts/deploy.js",
    "deploy:validate": "node scripts/deploy.js production --validate",
    "deploy:backup": "node scripts/deploy.js production --backup",
    "deploy:rollback": "node scripts/deploy.js production --rollback",
    "backup": "node scripts/backup.js all",
    "backup:registry": "node scripts/backup.js registry",
    "backup:content": "node scripts/backup.js content",
    "restore": "node scripts/restore.js",
    "validate:env": "node scripts/validate-env.js",
    "docker:build": "docker compose -f docker/compose.prod.yml build",
    "docker:up": "docker compose -f docker/compose.prod.yml up -d",
    "docker:down": "docker compose -f docker/compose.prod.yml down",
    "docker:logs": "docker compose -f docker/compose.prod.yml logs -f",
    "docker:ps": "docker compose -f docker/compose.prod.yml ps",
    "dev:admin": "turbo dev --filter=@bhavya/admin-app",
    "build:admin": "turbo build --filter=@bhavya/admin-app",
    "admin": "pnpm --filter @bhavya/admin-app dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
