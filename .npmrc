# Experiment A — hoisted pnpm layout (isolated, not a fix claim).
#
# pnpm's default isolated layout stores every package under
# node_modules/.pnpm/<name>@<version>/node_modules/<name> and links siblings
# with symlinks. Next's file tracer does not reproduce those sibling symlinks in
# the OpenNext packaged tree, so esbuild — which bundles from the packaged tree
# with platform "neutral" and conditions ["module"] — cannot resolve
# @libsql/isomorphic-ws from the copied hrana-client.
#
# A hoisted layout makes node_modules/@libsql/* real directories, which the
# tracer follows natively. This changes install layout for the whole workspace,
# so it is an architecture decision, not a local tweak.
node-linker=hoisted