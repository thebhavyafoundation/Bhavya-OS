{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bhavya.foundation/schemas/handoff.schema.json",
  "title": "ICM Stage Handoff Artifact",
  "description": "Schema for artifacts passed between ICM stages (Pattern 2)",
  "type": "object",
  "required": ["stage", "artifactType", "topicSlug", "content", "metadata"],
  "properties": {
    "stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99,
      "description": "Stage number that produced this artifact"
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "discovery-report",
        "spec",
        "reasons-canvas",
        "code-changes",
        "verification-report",
        "deployment-record",
        "onboarding-config"
      ],
      "description": "Type of handoff artifact"
    },
    "topicSlug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "URL-safe topic identifier (e.g., 'icm-workspace-implementation')"
    },
    "content": {
      "type": "string",
      "description": "Full artifact content (Markdown, JSON, etc.)"
    },
    "metadata": {
      "type": "object",
      "required": ["createdAt", "createdBy", "stageContractVersion"],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        },
        "createdBy": {
          "type": "string",
          "description": "Agent or human identifier"
        },
        "stageContractVersion": {
          "type": "string",
          "description": "Version/hash of the stage contract used"
        },
        "checkpointDecisions": {
          "type": "object",
          "description": "Decisions made at checkpoints",
          "additionalProperties": { "type": "string" }
        },
        "auditResults": {
          "type": "array",
          "description": "Results of stage audits",
          "items": {
            "type": "object",
            "properties": {
              "check": { "type": "string" },
              "passed": { "type": "boolean" },
              "notes": { "type": "string" }
            },
            "required": ["check", "passed"]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
