{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bhavya OS Agent Schema",
  "type": "object",
  "required": ["id", "name", "role", "permissions", "tools"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "role": { "type": "string" },
    "permissions": { "type": "object" },
    "tools": { "type": "array", "items": { "type": "string" } },
    "reports_to": { "type": ["string", "null"] }
  }
}
