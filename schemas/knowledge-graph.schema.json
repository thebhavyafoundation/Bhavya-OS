{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bhavya OS Knowledge Graph Schema",
  "type": "object",
  "required": ["version", "generatedAt", "nodes"],
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "links"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["adr", "rfc", "standard", "release", "workflow", "agent", "policy"] },
          "title": { "type": "string" },
          "links": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
