{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bhavya OS Event Contract Schema",
  "type": "object",
  "required": ["name", "version", "producer", "consumers", "payload_schema"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "producer": { "type": "string" },
    "consumers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "payload_schema": { "type": "object" }
  }
}
