{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bhavya OS Registry Schema",
  "type": "object",
  "required": ["registry_type", "generated_at", "generator", "items"],
  "properties": {
    "registry_type": {
      "type": "string",
      "enum": ["apps", "packages", "agents", "standards", "workflows", "services", "apis", "repositories"]
    },
    "generated_at": { "type": "string" },
    "generator": { "type": "string", "default": "scripts/generate-registry.js" },
    "items": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
