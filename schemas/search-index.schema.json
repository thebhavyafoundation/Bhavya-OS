{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bhavya OS Search Index Schema",
  "type": "object",
  "required": ["version", "generatedAt", "documents"],
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "path", "content"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "path": { "type": "string" },
          "content": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
