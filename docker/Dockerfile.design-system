# ============================================================
# Bhavya Foundation — Design System Dockerfile
# Multi-stage build for Storybook-style design system
# ============================================================

# ----------------------------------------------------------
# Stage 1: deps
# ----------------------------------------------------------
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/bdl/package.json packages/bdl/
COPY packages/branding/package.json packages/branding/
COPY packages/ui/package.json packages/ui/
COPY packages/typescript/package.json packages/typescript/
COPY apps/design-system/package.json apps/design-system/

RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile

# ----------------------------------------------------------
# Stage 2: builder
# ----------------------------------------------------------
FROM node:20-alpine AS builder

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps

COPY . .

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN cd apps/design-system && npx next build

# ----------------------------------------------------------
# Stage 3: runner
# ----------------------------------------------------------
FROM node:20-alpine AS runner

RUN apk add --no-cache curl tini && \
    addgroup -g 1001 -S bhavya && \
    adduser -S bhavya -u 1001 -G bhavya

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3010

COPY --from=builder /app/apps/design-system/.next/standalone ./
COPY --from=builder /app/apps/design-system/.next/static ./apps/design-system/.next/static
COPY --from=builder /app/apps/design-system/public ./apps/design-system/public

RUN chown -R bhavya:bhavya /app

USER bhavya

EXPOSE 3010

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3010/ || exit 1

ENTRYPOINT ["/sbin/tini", "--"]

CMD ["node", "apps/design-system/server.js"]
