FROM node:22-alpine AS base
RUN apk add --no-cache tini curl
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml package.json ./
COPY apps/admin/package.json ./apps/admin/
COPY packages/runtime/package.json ./packages/runtime/
COPY packages/mission-runtime/package.json ./packages/mission-runtime/
COPY packages/sdk/package.json ./packages/sdk/
RUN corepack enable && pnpm install --frozen-lockfile --filter @bhavya/admin-app...

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/admin/node_modules ./apps/admin/node_modules
COPY --from=deps /app/packages/runtime/node_modules ./packages/runtime/node_modules
COPY --from=deps /app/packages/mission-runtime/node_modules ./packages/mission-runtime/node_modules
COPY --from=deps /app/packages/sdk/node_modules ./packages/sdk/node_modules
COPY . .
RUN --mount=type=cache,target=/root/.cache/pnpm cd apps/admin && pnpm build

FROM base AS runner
RUN addgroup -g 1001 -S bhavya && adduser -S bhavya -u 1001
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=bhavya:bhavya /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=bhavya:bhavya /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder --chown=bhavya:bhavya /app/apps/admin/public ./apps/admin/public 2>/dev/null || true
USER bhavya
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -f http://localhost:3003/api/health || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/admin/server.js"]
