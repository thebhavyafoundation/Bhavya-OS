{
  "version": "1.0.0",
  "name": "Bhavya CLI",
  "description": "Command-line interface for the Bhavya AI Lab OS.",
  "commands": [
    {
      "name": "init",
      "usage": "bhavya init <workspace>",
      "description": "Initialize a new workspace",
      "template": "cli/templates/workspace/"
    },
    {
      "name": "build",
      "usage": "bhavya build <builder> <input>",
      "description": "Execute a builder",
      "examples": [
        "bhavya build lesson ko-ai-what-is-ai",
        "bhavya build video lesson-ai-001",
        "bhavya build website production"
      ]
    },
    {
      "name": "capability",
      "usage": "bhavya capability <name>",
      "description": "Resolve and execute a capability",
      "examples": [
        "bhavya capability lesson_generation",
        "bhavya capability video_generation"
      ]
    },
    {
      "name": "generate",
      "usage": "bhavya generate <type> <name>",
      "description": "Generate new project artifacts",
      "examples": [
        "bhavya generate builder video-builder",
        "bhavya generate skill remotion",
        "bhavya generate package @bhavya/history",
        "bhavya generate knowledge-object ai-foundations",
        "bhavya generate example explainer-video"
      ],
      "templates": {
        "builder": "cli/templates/builder/",
        "skill": "cli/templates/skill/",
        "package": "cli/templates/package/",
        "workspace": "cli/templates/workspace/"
      }
    },
    {
      "name": "validate",
      "usage": "bhavya validate [path]",
      "description": "Validate schemas, registries, and dependencies",
      "examples": [
        "bhavya validate",
        "bhavya validate knowledge/objects/",
        "bhavya validate _config/skills/registry.json"
      ]
    },
    {
      "name": "test",
      "usage": "bhavya test [suite]",
      "description": "Run test suites",
      "examples": [
        "bhavya test",
        "bhavya test builders",
        "bhavya test schemas"
      ]
    },
    {
      "name": "docs",
      "usage": "bhavya docs [component]",
      "description": "Generate documentation",
      "examples": [
        "bhavya docs",
        "bhavya docs skills",
        "bhavya docs builders"
      ]
    },
    {
      "name": "dashboard",
      "usage": "bhavya dashboard",
      "description": "View engineering dashboard",
      "options": ["--web", "open in browser", "--json", "output as JSON"]
    },
    {
      "name": "graph",
      "usage": "bhavya graph [component]",
      "description": "View dependency graph",
      "examples": [
        "bhavya graph",
        "bhavya graph capabilities",
        "bhavya graph packages"
      ]
    },
    {
      "name": "release",
      "usage": "bhavya release <channel>",
      "description": "Create a release",
      "examples": [
        "bhavya release development",
        "bhavya release staging",
        "bhavya release production"
      ]
    },
    {
      "name": "status",
      "usage": "bhavya status",
      "description": "Show platform status",
      "output": ["installed packages", "active skills", "build history", "validation status"]
    },
    {
      "name": "bpr",
      "usage": "bhavya bpr <command> <args>",
      "description": "Bhavya Package Registry commands",
      "subcommands": [
        "bhavya bpr install <package>",
        "bhavya bpr uninstall <package>",
        "bhavya bpr list",
        "bhavya bpr search <query>",
        "bhavya bpr publish",
        "bhavya bpr verify <package>"
      ]
    }
  ],
  "providers": {
    "help": "bhavya help <command>",
    "version": "bhavya --version",
    "completion": "bhavya completion"
  },
  "colors": {
    "primary": "#1E3A5F",
    "success": "#4CAF50",
    "warning": "#F59E0B",
    "error": "#EF4444",
    "info": "#3B82F6"
  }
}
