{
  "id": "website",
  "name": "Website Builder",
  "version": "1.0.0",
  "description": "Generates static websites from content",
  "input": "content",
  "output": ["static-site", "offline-package"],
  "skills": ["deployment", "react"],
  "registries": ["layouts", "components"],
  "pipeline": [
    {
      "step": "validate",
      "action": "Validate content against schema"
    },
    {
      "step": "structure",
      "action": "Generate site structure from content"
    },
    {
      "step": "compose",
      "action": "Compose pages from layouts and components"
    },
    {
      "step": "render",
      "action": "Render static site"
    },
    {
      "step": "package",
      "action": "Create offline package"
    }
  ]
}
