{
  "id": "quiz",
  "name": "Quiz Builder",
  "version": "1.0.0",
  "description": "Generates quizzes and assessments from Knowledge Objects",
  "input": "knowledge-object",
  "output": ["quiz-json", "flashcards", "online-quiz"],
  "skills": ["education", "qa"],
  "registries": ["curriculum", "schemas"],
  "pipeline": [
    {
      "step": "validate",
      "action": "Validate Knowledge Object against schema"
    },
    {
      "step": "generate",
      "action": "Generate questions from Knowledge Object"
    },
    {
      "step": "validate-questions",
      "action": "Validate questions against quality standards"
    },
    {
      "step": "format",
      "action": "Format quiz in multiple output formats"
    }
  ]
}
