{
  "id": "video",
  "name": "Video Builder",
  "version": "1.0.0",
  "description": "Compiles scripts into rendered videos and animations",
  "input": "script",
  "output": ["mp4", "webm", "gif", "thumbnail", "transcript"],
  "skills": ["remotion", "animation", "react"],
  "registries": ["components", "animations", "layouts"],
  "pipeline": [
    {
      "step": "validate",
      "action": "Validate script against schema"
    },
    {
      "step": "storyboard",
      "action": "Generate storyboard from script"
    },
    {
      "step": "compose",
      "action": "Compose Remotion components from storyboard"
    },
    {
      "step": "render",
      "action": "Render video with Remotion"
    },
    {
      "step": "validate-output",
      "action": "Validate video against quality standards"
    }
  ]
}
