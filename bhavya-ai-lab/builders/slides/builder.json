{
  "id": "slides",
  "name": "Slides Builder",
  "version": "1.0.0",
  "description": "Generates presentation slides from lessons",
  "input": "lesson",
  "output": ["pptx", "pdf-slides", "html-slides"],
  "skills": ["education", "writing"],
  "registries": ["layouts", "curriculum"],
  "pipeline": [
    {
      "step": "validate",
      "action": "Validate lesson against schema"
    },
    {
      "step": "outline",
      "action": "Generate slide outline from lesson"
    },
    {
      "step": "compose",
      "action": "Compose slides from outline"
    },
    {
      "step": "render",
      "action": "Render slides in multiple formats"
    }
  ]
}
