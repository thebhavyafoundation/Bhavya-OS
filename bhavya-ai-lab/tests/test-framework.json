{
  "version": "1.0.0",
  "description": "Automated test framework for all platform components.",
  "testSuites": [
    {
      "id": "builders",
      "name": "Builder Tests",
      "path": "tests/builders/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate all builders produce correct outputs",
      "coverage": "Required"
    },
    {
      "id": "registries",
      "name": "Registry Tests",
      "path": "tests/registries/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate registry integrity and references",
      "coverage": "Required"
    },
    {
      "id": "schemas",
      "name": "Schema Tests",
      "path": "tests/schemas/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate all schemas are valid JSON Schema",
      "coverage": "Required"
    },
    {
      "id": "skills",
      "name": "Skill Tests",
      "path": "tests/skills/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate skill structure and patterns",
      "coverage": "Required"
    },
    {
      "id": "compilers",
      "name": "Compiler Tests",
      "path": "tests/compilers/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate animation compiler pipeline",
      "coverage": "Required"
    },
    {
      "id": "runtime",
      "name": "Runtime Tests",
      "path": "tests/runtime/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate runtime, provider layer, orchestrator",
      "coverage": "Required"
    },
    {
      "id": "capabilities",
      "name": "Capability Tests",
      "path": "tests/capabilities/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate capability resolution",
      "coverage": "Required"
    },
    {
      "id": "gates",
      "name": "Quality Gate Tests",
      "path": "tests/gates/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate quality gate rules",
      "coverage": "Required"
    },
    {
      "id": "packages",
      "name": "Package Tests",
      "path": "tests/packages/",
      "files": "*.test.ts",
      "runner": "vitest",
      "description": "Validate package structure and exports",
      "coverage": "Required"
    }
  ],
  "requirements": [
    "Every package must include tests",
    "Every builder must include tests",
    "Every schema must include validation tests",
    "All tests must pass before release",
    "Code coverage minimum: 80%"
  ]
}
