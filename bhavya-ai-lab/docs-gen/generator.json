{
  "version": "1.0.0",
  "name": "Documentation Generator",
  "description": "Auto-generates documentation from codebase metadata. Always synchronized with the actual codebase.",
  "sources": [
    {
      "id": "packages",
      "path": "packages/*/package.json",
      "template": "docs-gen/templates/package.md",
      "output": "docs-gen/output/packages/",
      "fields": ["name", "version", "description", "dependencies", "exports"]
    },
    {
      "id": "skills",
      "path": "skills/*/skill.json",
      "template": "docs-gen/templates/skill.md",
      "output": "docs-gen/output/skills/",
      "fields": ["id", "name", "version", "description", "workspaces", "registries"]
    },
    {
      "id": "builders",
      "path": "builders/*/builder.json",
      "template": "docs-gen/templates/builder.md",
      "output": "docs-gen/output/builders/",
      "fields": ["id", "name", "input", "output", "skills", "pipeline"]
    },
    {
      "id": "capabilities",
      "path": "_config/skills/registry.json#/capabilities",
      "template": "docs-gen/templates/capability.md",
      "output": "docs-gen/output/capabilities/",
      "fields": ["capability", "builder", "skills", "workspace"]
    },
    {
      "id": "registries",
      "path": "_config/registries/",
      "template": "docs-gen/templates/registry.md",
      "output": "docs-gen/output/registries/",
      "fields": ["name", "type", "entries"]
    },
    {
      "id": "schemas",
      "path": "_config/schemas/",
      "template": "docs-gen/templates/schema.md",
      "output": "docs-gen/output/schemas/",
      "fields": ["name", "type", "fields"]
    },
    {
      "id": "examples",
      "path": "examples/*/template.json",
      "template": "docs-gen/templates/example.md",
      "output": "docs-gen/output/examples/",
      "fields": ["name", "type", "duration", "components"]
    }
  ],
  "templates": [
    {
      "id": "package.md",
      "content": "# {{name}}\n\n**Version:** {{version}}\n**Description:** {{description}}\n\n## Dependencies\n{{#each dependencies}}- {{this}}\n{{/each}}\n\n## Exports\n{{#each exports}}- `{{@key}}` → `{{this}}`\n{{/each}}"
    },
    {
      "id": "skill.md",
      "content": "# {{name}}\n\n**ID:** {{id}}\n**Version:** {{version}}\n**Workspaces:** {{workspaces}}\n\n## Description\n{{description}}\n\n## Registries\n{{#each registries}}- {{this}}\n{{/each}}"
    },
    {
      "id": "builder.md",
      "content": "# {{name}}\n\n**ID:** {{id}}\n**Input:** {{input}}\n**Output:** {{output}}\n\n## Skills\n{{#each skills}}- {{this}}\n{{/each}}\n\n## Pipeline\n{{#each pipeline}}- {{step}}: {{description}}\n{{/each}}"
    },
    {
      "id": "capability.md",
      "content": "# {{capability}}\n\n**Builder:** {{builder}}\n**Workspace:** {{workspace}}\n\n## Required Skills\n{{#each skills}}- {{this}}\n{{/each}}"
    }
  ],
  "hooks": {
    "pre-generate": ["validate-sources", "check-changes"],
    "post-generate": ["validate-output", "report-changes"]
  }
}
