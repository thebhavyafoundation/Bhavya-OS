{
  "version": "1.0.0",
  "name": "Multi-Agent Runtime",
  "description": "Specialized engineering agents. Each agent owns capabilities. Agents communicate through the runtime.",
  "agents": [
    {
      "id": "research-agent",
      "name": "Research Agent",
      "workspace": "research",
      "capabilities": ["research_analysis"],
      "skills": ["research", "writing"],
      "description": "Transforms topic requests into structured research briefs"
    },
    {
      "id": "curriculum-agent",
      "name": "Curriculum Agent",
      "workspace": "curriculum",
      "capabilities": ["lesson_generation", "quiz_generation", "slides_generation", "pdf_generation"],
      "skills": ["education", "writing", "qa"],
      "description": "Transforms research briefs into lessons, courses, assessments"
    },
    {
      "id": "animation-agent",
      "name": "Animation Agent",
      "workspace": "production",
      "capabilities": ["video_generation", "animation_generation", "diagram_generation"],
      "skills": ["remotion", "animation", "diagramming", "react"],
      "description": "Transforms scripts into rendered videos and animations"
    },
    {
      "id": "website-agent",
      "name": "Website Agent",
      "workspace": "platform",
      "capabilities": ["website_generation"],
      "skills": ["deployment", "react"],
      "description": "Transforms content into static websites and offline packages"
    },
    {
      "id": "documentation-agent",
      "name": "Documentation Agent",
      "workspace": "platform",
      "capabilities": [],
      "skills": ["writing"],
      "description": "Generates and maintains documentation"
    },
    {
      "id": "qa-agent",
      "name": "QA Agent",
      "workspace": "platform",
      "capabilities": [],
      "skills": ["qa"],
      "description": "Runs quality gates and validates outputs"
    },
    {
      "id": "release-agent",
      "name": "Release Agent",
      "workspace": "platform",
      "capabilities": [],
      "skills": ["deployment"],
      "description": "Manages release pipeline and versioning"
    },
    {
      "id": "governance-agent",
      "name": "Governance Agent",
      "workspace": "institution",
      "capabilities": [],
      "skills": [],
      "description": "Maintains institutional memory, decisions, and governance records"
    }
  ],
  "communication": {
    "protocol": "capability-request",
    "channel": "runtime",
    "format": {
      "from": "agent-id",
      "to": "agent-id",
      "capability": "capability-name",
      "payload": "any",
      "timestamp": "ISO8601"
    }
  },
  "ownership": {
    "research-agent": ["research_analysis"],
    "curriculum-agent": ["lesson_generation", "quiz_generation", "slides_generation", "pdf_generation"],
    "animation-agent": ["video_generation", "animation_generation", "diagram_generation"],
    "website-agent": ["website_generation"]
  }
}
