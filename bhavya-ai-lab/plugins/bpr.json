{
  "version": "1.0.0",
  "name": "Bhavya Package Registry (BPR)",
  "description": "The BPR plugin system. Every package is installable. Plugins contribute builders, components, skills, schemas, templates, examples, and registries.",
  "commands": {
    "install": {
      "usage": "bpr install <package>",
      "examples": [
        "bpr install @bhavya/remotion",
        "bpr install @bhavya/history",
        "bpr install @bhavya/biology",
        "bpr install @bhavya/community",
        "bpr install @himalayan/assets",
        "bpr install @ai-foundations/curriculum"
      ],
      "steps": [
        "Resolve package name",
        "Verify package signature",
        "Download package files",
        "Validate package structure",
        "Register skills in registry.json",
        "Copy components to registries",
        "Copy schemas to _config/schemas/",
        "Register builders",
        "Copy templates",
        "Verify installation"
      ]
    },
    "uninstall": {
      "usage": "bpr uninstall <package>",
      "steps": [
        "Resolve package name",
        "Verify no dependents",
        "Remove from registry.json",
        "Remove components",
        "Remove schemas",
        "Remove builders",
        "Remove templates",
        "Verify removal"
      ]
    },
    "list": {
      "usage": "bpr list",
      "output": "Installed packages with versions"
    },
    "search": {
      "usage": "bpr search <query>",
      "description": "Search available packages"
    },
    "publish": {
      "usage": "bpr publish",
      "description": "Publish a package to the registry",
      "requirements": ["package.json", "skill.json", "schema validation"]
    },
    "update": {
      "usage": "bpr update <package>",
      "description": "Update a package to latest version"
    },
    "verify": {
      "usage": "bpr verify <package>",
      "description": "Verify package integrity"
    }
  },
  "packageStructure": {
    "required": ["package.json", "skill.json"],
    "optional": [
      "components/",
      "schemas/",
      "registries/",
      "builders/",
      "templates/",
      "examples/",
      "tests/"
    ],
    "validation": [
      "package.json must have name, version, description",
      "skill.json must match registry schema",
      "All paths referenced in package.json must exist",
      "No circular dependencies with other packages"
    ]
  },
  "installedPackages": {
    "@bhavya/core": { "version": "1.0.0", "status": "system" },
    "@bhavya/education": { "version": "1.0.0", "status": "system" },
    "@bhavya/remotion": { "version": "1.0.0", "status": "system" },
    "@bhavya/website": { "version": "1.0.0", "status": "system" },
    "@bhavya/knowledge": { "version": "1.0.0", "status": "system" },
    "@bhavya/assessment": { "version": "1.0.0", "status": "system" },
    "@bhavya/community": { "version": "1.0.0", "status": "system" }
  }
}
