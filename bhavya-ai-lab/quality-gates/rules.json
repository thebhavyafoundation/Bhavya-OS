{
  "version": "1.0.0",
  "gates": [
    {
      "id": "structure",
      "name": "Folder Structure",
      "description": "Validate workspace folder structure",
      "checks": [
        {
          "id": "required-folders",
          "name": "Required Folders Exist",
          "severity": "error",
          "rule": "All required workspace folders must exist"
        },
        {
          "id": "context-file",
          "name": "CONTEXT.md Exists",
          "severity": "error",
          "rule": "Each workspace must have CONTEXT.md"
        },
        {
          "id": "manifest-file",
          "name": "MANIFEST.md Exists",
          "severity": "warning",
          "rule": "Each workspace should have MANIFEST.md"
        }
      ]
    },
    {
      "id": "schemas",
      "name": "Schema Validation",
      "description": "Validate data against schemas",
      "checks": [
        {
          "id": "knowledge-object",
          "name": "Knowledge Object Schema",
          "severity": "error",
          "rule": "Knowledge Objects must match schema"
        },
        {
          "id": "lesson-schema",
          "name": "Lesson Schema",
          "severity": "error",
          "rule": "Lessons must match schema"
        },
        {
          "id": "video-schema",
          "name": "Video Schema",
          "severity": "error",
          "rule": "Videos must match schema"
        }
      ]
    },
    {
      "id": "assets",
      "name": "Asset Validation",
      "description": "Validate all assets exist",
      "checks": [
        {
          "id": "images-exist",
          "name": "Images Exist",
          "severity": "error",
          "rule": "All referenced images must exist"
        },
        {
          "id": "fonts-exist",
          "name": "Fonts Exist",
          "severity": "error",
          "rule": "All referenced fonts must exist"
        },
        {
          "id": "audio-exist",
          "name": "Audio Files Exist",
          "severity": "error",
          "rule": "All referenced audio files must exist"
        }
      ]
    },
    {
      "id": "components",
      "name": "Component Reuse",
      "description": "Validate component reuse",
      "checks": [
        {
          "id": "check-registry",
          "name": "Check Registry First",
          "severity": "warning",
          "rule": "Always check registry before generating new components"
        },
        {
          "id": "reuse-existing",
          "name": "Reuse Existing Components",
          "severity": "warning",
          "rule": "Reuse existing components when possible"
        }
      ]
    },
    {
      "id": "accessibility",
      "name": "Accessibility",
      "description": "Validate accessibility standards",
      "checks": [
        {
          "id": "color-contrast",
          "name": "Color Contrast",
          "severity": "error",
          "rule": "Text must have contrast ratio ≥ 4.5:1"
        },
        {
          "id": "alt-text",
          "name": "Alt Text",
          "severity": "error",
          "rule": "All images must have alt text"
        },
        {
          "id": "keyboard-nav",
          "name": "Keyboard Navigation",
          "severity": "error",
          "rule": "All interactive elements must be keyboard accessible"
        },
        {
          "id": "reduced-motion",
          "name": "Reduced Motion",
          "severity": "warning",
          "rule": "Support prefers-reduced-motion"
        }
      ]
    },
    {
      "id": "performance",
      "name": "Performance",
      "description": "Validate performance standards",
      "checks": [
        {
          "id": "image-optimization",
          "name": "Image Optimization",
          "severity": "warning",
          "rule": "Images should be optimized"
        },
        {
          "id": "bundle-size",
          "name": "Bundle Size",
          "severity": "warning",
          "rule": "Bundle size should be reasonable"
        },
        {
          "id": "no-layout-shift",
          "name": "No Layout Shift",
          "severity": "error",
          "rule": "Avoid cumulative layout shift"
        }
      ]
    },
    {
      "id": "responsive",
      "name": "Responsive Design",
      "description": "Validate responsive layouts",
      "checks": [
        {
          "id": "mobile-first",
          "name": "Mobile First",
          "severity": "warning",
          "rule": "Use mobile-first approach"
        },
        {
          "id": "breakpoints",
          "name": "Breakpoints",
          "severity": "warning",
          "rule": "Test at all breakpoints"
        },
        {
          "id": "touch-targets",
          "name": "Touch Targets",
          "severity": "error",
          "rule": "Touch targets must be ≥ 44px on mobile"
        }
      ]
    },
    {
      "id": "naming",
      "name": "Naming Conventions",
      "description": "Validate naming conventions",
      "checks": [
        {
          "id": "file-naming",
          "name": "File Naming",
          "severity": "warning",
          "rule": "Use kebab-case for files"
        },
        {
          "id": "component-naming",
          "name": "Component Naming",
          "severity": "warning",
          "rule": "Use PascalCase for components"
        },
        {
          "id": "type-naming",
          "name": "Type Naming",
          "severity": "warning",
          "rule": "Use PascalCase with Props suffix"
        }
      ]
    },
    {
      "id": "imports",
      "name": "Import Validation",
      "description": "Validate imports",
      "checks": [
        {
          "id": "no-broken-imports",
          "name": "No Broken Imports",
          "severity": "error",
          "rule": "All imports must resolve"
        },
        {
          "id": "no-unused-imports",
          "name": "No Unused Imports",
          "severity": "warning",
          "rule": "Remove unused imports"
        },
        {
          "id": "consistent-imports",
          "name": "Consistent Imports",
          "severity": "warning",
          "rule": "Use consistent import order"
        }
      ]
    },
    {
      "id": "dependencies",
      "name": "Builder Dependencies",
      "description": "Validate builder dependencies",
      "checks": [
        {
          "id": "skills-available",
          "name": "Skills Available",
          "severity": "error",
          "rule": "Required skills must be available"
        },
        {
          "id": "registries-available",
          "name": "Registries Available",
          "severity": "error",
          "rule": "Required registries must be available"
        },
        {
          "id": "schemas-available",
          "name": "Schemas Available",
          "severity": "error",
          "rule": "Required schemas must be available"
        }
      ]
    }
  ]
}
