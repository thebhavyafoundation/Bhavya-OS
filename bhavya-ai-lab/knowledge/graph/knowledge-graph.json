{
  "version": "1.0.0",
  "description": "Knowledge Graph. Transforms Knowledge Objects into a navigable graph of concepts, prerequisites, citations, learning paths, and cross-references.",
  "nodes": [
    {
      "id": "concept-ai",
      "type": "concept",
      "label": "Artificial Intelligence",
      "source": "knowledge/concepts/ai.md"
    },
    {
      "id": "concept-machine-learning",
      "type": "concept",
      "label": "Machine Learning",
      "source": "knowledge/concepts/machine-learning.md"
    },
    {
      "id": "concept-neural-networks",
      "type": "concept",
      "label": "Neural Networks",
      "source": "knowledge/concepts/neural-networks.md"
    },
    {
      "id": "concept-data",
      "type": "concept",
      "label": "Data",
      "source": "knowledge/concepts/data.md"
    },
    {
      "id": "concept-algorithms",
      "type": "concept",
      "label": "Algorithms",
      "source": "knowledge/concepts/algorithms.md"
    },
    {
      "id": "ko-ai-what-is-ai",
      "type": "knowledge-object",
      "label": "What is AI?",
      "source": "knowledge/objects/ko-ai-what-is-ai.json"
    }
  ],
  "edges": [
    { "from": "concept-machine-learning", "to": "concept-ai", "type": "subconcept-of" },
    { "from": "concept-neural-networks", "to": "concept-machine-learning", "type": "subconcept-of" },
    { "from": "concept-algorithms", "to": "concept-ai", "type": "prerequisite-for" },
    { "from": "concept-data", "to": "concept-machine-learning", "type": "prerequisite-for" },
    { "from": "ko-ai-what-is-ai", "to": "concept-ai", "type": "teaches" },
    { "from": "ko-ai-what-is-ai", "to": "concept-machine-learning", "type": "teaches" },
    { "from": "ko-ai-what-is-ai", "to": "concept-data", "type": "teaches" }
  ],
  "queries": {
    "prerequisites": "Find all nodes required to understand a given concept",
    "learning-path": "Generate an ordered learning path from prerequisites to target concept",
    "cross-references": "Find all Knowledge Objects that reference a given concept",
    "related-concepts": "Find concepts related through shared Knowledge Objects",
    "citations": "Find all citations for a given concept or Knowledge Object"
  },
  "operations": {
    "prerequisites": {
      "description": "Find prerequisites for learning a concept",
      "input": "concept-id",
      "output": ["concept-id", "knowledge-object-id"],
      "algorithm": "BFS-traversal"
    },
    "learning-path": {
      "description": "Generate a learning path from current knowledge to target",
      "input": { "current": "[concept-id]", "target": "concept-id" },
      "output": "[knowledge-object-id]",
      "algorithm": "shortest-path"
    },
    "lesson-reuse": {
      "description": "Find lessons that can be reused across different courses",
      "input": "concept-id",
      "output": "[knowledge-object-id]",
      "algorithm": "shared-node-detection"
    }
  }
}
