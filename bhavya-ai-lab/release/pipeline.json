{
  "version": "1.0.0",
  "name": "Release Pipeline",
  "description": "Manages development, staging, production, release candidates, rollback, changelogs, and version management.",
  "channels": {
    "development": {
      "description": "Active development branch",
      "versionSuffix": "dev",
      "autoDeploy": true,
      "validation": ["lint", "typecheck", "unit-tests"]
    },
    "staging": {
      "description": "Integration testing",
      "versionSuffix": "beta",
      "autoDeploy": false,
      "validation": ["lint", "typecheck", "unit-tests", "integration-tests"]
    },
    "release-candidate": {
      "description": "Pre-production validation",
      "versionSuffix": "rc",
      "autoDeploy": false,
      "validation": ["full-test-suite", "qa-review", "security-scan"]
    },
    "production": {
      "description": "Live release",
      "versionSuffix": null,
      "autoDeploy": false,
      "validation": ["full-test-suite", "qa-review", "security-scan", "approval"]
    }
  },
  "versioning": {
    "scheme": "semver",
    "format": "MAJOR.MINOR.PATCH",
    "breakdown": {
      "MAJOR": "Breaking changes to public API or architecture",
      "MINOR": "New capabilities, builders, packages, features",
      "PATCH": "Bug fixes, documentation, minor improvements"
    },
    "sources": {
      "runtime.json": "runtime.json#/version",
      "CLAUDE": "CLAUDE.md#/identity",
      "registry": "_config/skills/registry.json"
    }
  },
  "pipeline": {
    "steps": [
      { "step": "version", "description": "Bump version based on change type" },
      { "step": "lint", "description": "Run ESLint across codebase" },
      { "step": "typecheck", "description": "Run TypeScript compiler check" },
      { "step": "test", "description": "Run test framework" },
      { "step": "validate-schemas", "description": "Validate all JSON schemas" },
      { "step": "validate-registries", "description": "Validate all registry references" },
      { "step": "generate-changelog", "description": "Generate changelog from commits" },
      { "step": "generate-release-notes", "description": "Generate release notes" },
      { "step": "tag-release", "description": "Create git tag for release" },
      { "step": "promote", "description": "Promote to next channel" }
    ]
  },
  "rollback": {
    "strategy": "version-revert",
    "triggers": ["validation-failure", "critical-bug", "security-issue"],
    "maxRollbacks": 3
  }
}
