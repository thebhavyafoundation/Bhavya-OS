{
  "id": "bhavya-runtime",
  "version": "3.0.0",
  "name": "Bhavya AI Lab Runtime",
  "description": "Core execution runtime. Resolves capabilities, loads providers, executes builders, publishes artifacts.",
  "components": {
    "provider": {
      "path": "providers/interfaces/ai-provider.json",
      "description": "AI provider abstraction layer"
    },
    "orchestrator": {
      "path": "orchestrator/pipeline/orchestrator.json",
      "description": "Pipeline orchestration engine"
    },
    "dependency-graph": {
      "path": "dependency-graph/data/graph.json",
      "description": "Dependency resolution"
    },
    "registry": {
      "path": "_config/skills/registry.json",
      "description": "Skill and capability registry"
    },
    "observability": {
      "path": "observability/metrics/collector.json",
      "description": "Metrics and logging"
    },
    "quality-gates": {
      "path": "quality-gates/rules.json",
      "description": "Validation gates"
    },
    "security": {
      "path": "security/policies/policy.json",
      "description": "Security policies"
    }
  },
  "flow": {
    "steps": [
      "User sends capability request",
      "Runtime resolves capability to builder",
      "Runtime loads required skills from registry",
      "Runtime loads required registries",
      "Runtime resolves dependencies via dependency graph",
      "Runtime loads provider (default: opencode)",
      "Orchestrator executes pipeline",
      "Quality gates validate each step",
      "Observability records metrics",
      "Artifacts are published"
    ]
  },
  "principles": [
    "Model independent - runtime never references a specific AI provider",
    "Deterministic - same input always produces same output",
    "Portable - all data is filesystem-based",
    "Versioned - every component has semver",
    "Testable - every component has tests"
  ]
}
