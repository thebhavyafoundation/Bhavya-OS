{
  "id": "educational-lesson",
  "name": "Educational Lesson Template",
  "version": "1.0.0",
  "description": "Reusable template for educational lessons",
  "duration": "10-15 minutes",
  "fps": 30,
  "resolution": "1920x1080",
  "structure": [
    {
      "name": "Title",
      "duration": 5,
      "purpose": "Lesson title and learning objectives"
    },
    {
      "name": "Prerequisites",
      "duration": 30,
      "purpose": "What students need to know before this lesson"
    },
    {
      "name": "Concept Introduction",
      "duration": 60,
      "purpose": "Introduce the main concept"
    },
    {
      "name": "Visual Explanation",
      "duration": 120,
      "purpose": "Visual demonstration of the concept"
    },
    {
      "name": "Examples",
      "duration": 180,
      "purpose": "Concrete examples with local context"
    },
    {
      "name": "Practice",
      "duration": 120,
      "purpose": "Practice exercises"
    },
    {
      "name": "Summary",
      "duration": 30,
      "purpose": "Key takeaways"
    }
  ],
  "components": [
    "TitleCard",
    "LearningObjectives",
    "ConceptCard",
    "VisualDemo",
    "ExampleCard",
    "PracticeCard",
    "SummaryCard"
  ],
  "skills": ["remotion", "education", "writing"],
  "registries": ["components", "animations", "layouts"]
}
