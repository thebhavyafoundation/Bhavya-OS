{
  "id": "explainer-video",
  "name": "Explainer Video Template",
  "version": "1.0.0",
  "description": "Reusable template for educational explainer videos",
  "duration": "60-90 seconds",
  "fps": 30,
  "resolution": "1920x1080",
  "structure": [
    {
      "name": "Hook",
      "duration": 5,
      "purpose": "Grab attention with a question or surprising fact"
    },
    {
      "name": "Problem",
      "duration": 10,
      "purpose": "Define the problem being solved"
    },
    {
      "name": "Solution",
      "duration": 30,
      "purpose": "Explain the solution step by step"
    },
    {
      "name": "Example",
      "duration": 15,
      "purpose": "Show a concrete example"
    },
    {
      "name": "Summary",
      "duration": 5,
      "purpose": "Recap key points"
    },
    {
      "name": "CTA",
      "duration": 5,
      "purpose": "Call to action"
    }
  ],
  "components": [
    "TitleCard",
    "ProblemStatement",
    "StepByStep",
    "ExampleCard",
    "SummaryCard",
    "CTACard"
  ],
  "skills": ["remotion", "education", "writing"],
  "registries": ["components", "animations", "layouts"]
}
