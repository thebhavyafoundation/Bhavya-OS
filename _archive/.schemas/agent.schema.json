{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Schema",
  "description": "Schema for AI agent definitions",
  "type": "object",
  "required": ["id", "name", "role", "capabilities", "permissions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z-]+$",
      "description": "Unique agent identifier"
    },
    "name": {
      "type": "string",
      "description": "Human-readable agent name"
    },
    "role": {
      "type": "string",
      "enum": [
        "founder",
        "ceo",
        "cto",
        "developer",
        "designer",
        "reviewer",
        "researcher",
        "writer",
        "seo",
        "translator",
        "historian",
        "legal",
        "volunteer",
        "donation",
        "social-media",
        "qa",
        "release",
        "security"
      ],
      "description": "Agent role"
    },
    "description": {
      "type": "string",
      "description": "What this agent does"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What this agent can do"
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What this agent is allowed to access"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other agents this agent depends on"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "deprecated"],
      "default": "active"
    }
  }
}
