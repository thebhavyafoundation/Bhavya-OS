  "waveO": {
    "note": "Wave O orphan classification. Deferred routes are NOT in canonical navigation.",
    "redirected": [
      {
        "from": "/portfolio",
        "to": "/app/profile",
        "reason": "Overlaps /app/profile, hardcoded stats, no inbound links"
      }
    ],
    "deferred": [
      {
        "route": "/playground",
        "reason": "8-tab lab, 8 component libs, needs architectural decision"
      },
      {
        "route": "/programs",
        "reason": "Editorial programs, broken sub-routes, needs product decision"
      }
    ],
    "promoted": [
      {
        "route": "/learning-paths",
        "reason": "Wave Q: 8/8 flagship stages connected to published courses. Canonical curriculum graph.",
        "wave": "Q"
      }
    ],
    "legacyRedirects": [
      {
        "from": "/courses/foundations",
        "to": "/courses/ai-foundations",
        "reason": "Legacy single-course data system consolidated into canonical curriculum",
        "wave": "R"
      },
      {
        "from": "/courses/foundations/lessons/:id",
        "to": "/courses/ai-foundations",
        "reason": "Numeric lesson IDs do not map to canonical string IDs",
        "wave": "R"
      },
      {
        "from": "/courses/foundations/lab",
        "to": "/courses/ai-foundations",
        "reason": "Interactive lab not part of canonical course system",
        "wave": "R"
      },
      {
        "from": "/courses/foundations/check",
        "to": "/courses/ai-foundations",
        "reason": "Knowledge check not part of canonical course system",
        "wave": "R"
      },
      {
        "from": "/courses/foundations/project",
        "to": "/courses/ai-foundations",
        "reason": "Capstone project not part of canonical course system",
        "wave": "R"
      }
    ]
