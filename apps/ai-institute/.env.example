# Bhavya AI Institute — Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT COMMIT .env.local — it's in .gitignore

# =============================================================================
# SUPABASE AUTHENTICATION
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# =============================================================================
# B2 CLOUD STORAGE (Backblaze B2) — For 3D assets, large textures, datasets
# =============================================================================
# Get these from: https://backblazeb2.com/ > Buckets > Create App Key
# Use canonical B2_* names. S3_* aliases are supported as temporary fallbacks.
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_S3_REGION=us-east-005
B2_ACCESS_KEY_ID=your_b2_key_id
B2_SECRET_ACCESS_KEY=your_b2_application_key
B2_BUCKET=your-bucket-name
B2_PUBLIC_BASE_URL=https://f002.backblazeb2.com/file/your-bucket-name

# Deprecated aliases (will be removed in a future release)
# S3_ENDPOINT=https://backblazeb2.com
# S3_REGION=us-east-0
# S3_ACCESS_KEY_ID=your_b2_key_id
# S3_SECRET_ACCESS_KEY=your_b2_application_key
# S3_BUCKET_NAME=your-bucket-name

# =============================================================================
# TURSO DATABASE (Production) — Optional, for remote SQLite
# =============================================================================
# Get these from: https://turso.tech/ > Databases > Connection
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# =============================================================================
# CLOUDFLARE DEPLOYMENT
# =============================================================================
# Cloudflare Workers/Pages deployment handled via wrangler.json
# Secrets set in Cloudflare dashboard: https://dash.cloudflare.com/
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - B2_S3_ENDPOINT
# - B2_ACCESS_KEY_ID
# - B2_SECRET_ACCESS_KEY
# - B2_BUCKET
# - TURSO_DATABASE_URL
# - TURSO_AUTH_TOKEN

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# =============================================================================
# GITHUB PAGES (For static asset hosting fallback)
# =============================================================================
NEXT_PUBLIC_GITHUB_PAGES_URL=https://yourusername.github.io/your-repo

# =============================================================================
# APPLICATION
# =============================================================================
# Canonical site URL (used for absolute URLs in emails, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=https://bhavyafoundation.org

# Authentication URL
NEXT_PUBLIC_AUTH_URL=https://bhavyafoundation.org/login

# Feature flags
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Environment marker: local | preview | production
ENVIRONMENT=local