  <!-- Snow caps -->
  <polygon points="850,420 900,400 950,430" fill="#F7F4EC" opacity="0.4"/>
  <polygon points="1450,370 1500,350 1550,380" fill="#F7F4EC" opacity="0.4"/>
  <!-- Text -->
