<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="knowledge" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1a3358"/>
      <stop offset="50%" stop-color="#122240"/>
      <stop offset="100%" stop-color="#0a1628"/>
    </linearGradient>
  </defs>
  <rect width="1920" height="1080" fill="url(#knowledge)"/>
  <!-- Mountains -->
