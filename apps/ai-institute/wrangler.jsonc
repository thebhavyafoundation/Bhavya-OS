// Required for OpenNext on Cloudflare. The repository did not have a Wrangler
// configuration, so the Worker was being deployed without declaring its entry
// point or the compatibility flags the runtime requires.
//
// nodejs_compat is not optional here. The Turso/libSQL chain reaches Node
// built-ins and `ws`; without the flag the Worker has no Node runtime
// compatibility and those calls fail at runtime even if bundling succeeds.
// Cloudflare requires compatibility_date of 2024-09-23 or later alongside it.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bhavya-foundation",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}