{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Schema",
  "description": "Schema for event definitions",
  "type": "object",
  "required": ["id", "name", "type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z.]+$",
      "description": "Unique event identifier (e.g., page.created)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable event name"
    },
    "description": {
      "type": "string",
      "description": "What this event represents"
    },
    "type": {
      "type": "string",
      "enum": ["system", "user", "ai", "external"],
      "description": "Event source type"
    },
    "payload": {
      "type": "object",
      "description": "Event data structure"
    },
    "handlers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent": { "type": "string" },
          "action": { "type": "string" }
        }
      },
      "description": "How to handle this event"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive"],
      "default": "active"
    }
  }
}