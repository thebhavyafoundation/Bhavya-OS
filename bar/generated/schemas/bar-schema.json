{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bhavya Architecture Registry Entity",
  "description": "Base schema for all BAR entities. Every capability, workflow, skill, agent, service, package, application, event, permission, KO, and UI surface conforms to this schema.",
  "type": "object",
  "required": ["id", "name", "version", "status", "kind", "sourceAdr"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[A-Z0-9]{2,6}(-[a-z0-9-]+)?$",
      "description": "Stable unique identifier. Format: {DOMAIN}-{NUMBER} or {DOMAIN}-{NUMBER}-{qualifier}"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "Human-readable name"
    },
    "kind": {
      "type": "string",
      "enum": [
        "domain",
        "capability",
        "workflow",
        "skill",
        "agent",
        "service",
        "package",
        "application",
        "knowledge-object",
        "event",
        "permission",
        "ui-surface"
      ],
      "description": "Entity type"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version"
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "deprecated", "archived"],
      "description": "Lifecycle status"
    },
    "owner": {
      "type": "string",
      "description": "Team or person responsible"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "What this entity does"
    },
    "domain": {
      "type": "string",
      "description": "Parent domain ID (e.g., D05)"
    },
    "adr": {
      "type": "string",
      "description": "Source ADR number (e.g., ADR-006)"
    },
    "sourceAdr": {
      "type": "string",
      "description": "Source ADR reference"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of entities this depends on"
    },
    "upstream": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of entities that feed into this"
    },
    "downstream": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of entities this feeds into"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of related entities"
    },
    "implementation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-started", "in-progress", "implemented", "partial"]
        },
        "location": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "planned", "written", "passing"]
        },
        "location": {
          "type": "string"
        }
      }
    },
    "docs": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "planned", "written", "published"]
        },
        "location": {
          "type": "string"
        }
      }
    },
    "release": {
      "type": "string",
      "description": "Release version when this was shipped"
    },
    "automation": {
      "type": "string",
      "enum": ["manual", "assisted", "semi-auto", "autonomous"],
      "description": "Automation level"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "metadata": {
      "type": "object",
      "description": "Additional domain-specific data"
    }
  }
}
