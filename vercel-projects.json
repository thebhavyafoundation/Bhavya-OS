{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "projects": {
    "website": {
      "name": "bhavya-website",
      "framework": "nextjs",
      "rootDirectory": ".",
      "installCommand": "pnpm install",
      "buildCommand": "pnpm --filter @bhavya/website build",
      "outputDirectory": "apps/website/.next",
      "developmentCommand": "pnpm --filter @bhavya/website dev",
      "domains": ["bhavyafoundation.org", "www.bhavyafoundation.org"]
